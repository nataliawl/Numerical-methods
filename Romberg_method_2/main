import numpy as np
from numpy.typing import NDArray
import matplotlib.pyplot as plt

number = np.float64
vector = NDArray[np.float64]

def integral(x: number) -> number:
    return np.cos((1 + x)/(x**2 + 0.04)) * np.exp(-(x**2))

def romberg_method(x_p:number, x_k:number):
    stop = 1e-8
    max = 30
    A_k = []

    d_x = x_k - x_p
    A_k.append([(d_x / 2) * (integral(x_p) + integral(x_k))])

    for k in range(1, max + 1):
        d_x /= 2

        points = np.arange(x_p+ d_x, x_k, 2*d_x)
        sum_of_trapez = A_k[k - 1][0] / 2 + d_x * np.sum(integral(points))
        row = [sum_of_trapez]

        for n in range(1, k + 1):
            value = ((4 ** n) * row[n - 1] - A_k[k - 1][n - 1]) / ((4 ** n)- 1)
            row.append(value)

        A_k.append(row)

        if np.abs(A_k[k][k] - A_k[k - 1][k-1]) < stop:
            return A_k

    return A_k

def get_limit(A_k : number) -> number:
    R = romberg_method(-A_k, A_k)
    return R[-1][-1]

def F_x(x: number, A_k : number, limit: number) -> vector:
    if x <= -A_k:
        return 0.0
    if x >= A_k :
        return limit
    R = romberg_method(-A_k, x)
    return R[-1][-1]


def main():
    A_k = 5.0
    limit = get_limit(A_k)
    print(f"Granica funkcji f(x) = cos(x) / (x^2 + 0.04) w przedziale [{-A_k}, {A_k}] wynosi: {limit}")
    x_vector = np.linspace(-A_k, A_k, 1000)
    x_value = [F_x(x, A_k, limit) for x in x_vector]
    plt.plot(x_vector, x_value, color="purple")
    plt.xlabel("x")
    plt.ylabel("F(x)")
    plt.title("Wykres funkcji F(x)")
    plt.grid(True)
    plt.show()

if __name__ == "__main__":
    main()
