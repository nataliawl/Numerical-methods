import numpy as np
import matplotlib.pyplot as plt
from numba import njit
from numpy.typing import NDArray

vector = NDArray[np.float64]
def gauss_seidel_pom(x: vector, previous_x : vector, D: vector):
    n = len(x)
    x[0] = (1.0 - previous_x[1] - previous_x[4]) / D[0]

    for i in range(1, 4):
        x[i] = (1.0 - x[i - 1] - previous_x[i + 1] - previous_x[i + 4]) / D[i]

    for i in range(4, n - 4):
        x[i] = (1.0 - x[i - 1] - previous_x[i + 1] - x[i - 4] - previous_x[i + 4]) / D[i]

    for i in range(n - 4, n - 1):
        x[i] = (1.0 - x[i - 1] - x[i - 4] - previous_x[i + 1]) / D[i]

    x[n - 1] = (1.0 - x[n - 2] - x[n - 5]) / D[n - 1]

def gauss_seidel(D: vector) -> tuple[int, list[np.float64]]:
    number = 0
    n = len(D)
    x: vector = np.zeros(n, dtype=np.float64)
    previous_x: vector = np.zeros(n, dtype=np.float64)
    history_of_gauss = []

    for number in range(1,101):
        previous_x[:] = x
        gauss_seidel_pom(x, previous_x, D)
        norm = np.linalg.norm(x - previous_x)
        history_of_gauss.append(norm)
        if norm < 1e-12:
            break

    return number, history_of_gauss

def conjugate_gradient(previous_x : vector, D: vector) -> tuple[int, list[np.float64]]:
    x = previous_x.copy()
    r = 1.0 - calulate_A(x, D)
    p = r.copy()
    previous_rTr = np.dot(r, r)

    history = []  # lista norm
    i = 1
    for i in range(1, 101):
        Ap = calulate_A(p, D)
        a = previous_rTr / np.dot(p, Ap)
        r = r - a * Ap
        new_x = x + a * p
        history.append(np.linalg.norm(new_x - x))

        if np.linalg.norm(r) < 1e-12:
            break

        new_rTr = np.dot(r, r)
        beta = new_rTr / previous_rTr
        p = r + beta * p

        x = new_x,
        previous_rTr = new_rTr

    return i + 1 , history


@njit(fastmath=True)
def calulate_A(x: vector, D: vector) -> vector:
    y = D * x
    n = len(x)

    for i in range(n - 4):
        y[i + 1] += x[i]
        y[i] += x[i + 1]

        y[i + 4] += x[i]
        y[i] += x[i + 4]

    for i in range(n - 4 , n - 1):
        y[i + 1] += x[i]
        y[i] += x[i + 1]

    return y

def main() -> None:
    #Metoda gaussa-seidela
    D: vector = np.full(128, 4.0)
    iterations, history_of_gauss = gauss_seidel(D)
    print(f"iterations: {iterations}")

    #Metoda gradientow sprzezonych
    x = np.zeros(128, dtype=np.float64)
    iterations_2 , history_of_gradients = conjugate_gradient(x, D)
    print(f"iterations_2: {iterations_2}")

    #Tworzymy wykres
    plt.plot(history_of_gauss, label="Gauss-Seidel", color="purple")
    plt.plot(history_of_gradients, label="Gradienty sprzężone", color="green")
    plt.title("Porównanie zbieźności")
    plt.xlabel("Liczba iteracji")
    plt.ylabel("Wartość norm")
    plt.legend()
    plt.grid(True)
    plt.yscale("log")
    plt.show()

main()
