import numpy as np

number = np.float64

def f_x(x: number) -> number:
    return np.sin(np.pi * (1 + np.sqrt(x)) / (1 + x**2)) * np.exp(-x)

def romberg_method(x_p:number, x_k:number) -> list:
    stop = 1e-7
    max = 30
    A_k = []

    d_x = x_k - x_p
    A_k.append([(d_x / 2) * (f_x(x_p) + f_x(x_k))])

    for k in range(1, max + 1):
        d_x /= 2

        points = np.arange(x_p+ d_x, x_k, 2*d_x)
        sum_of_trapez = A_k[k - 1][0] / 2 + d_x * np.sum(f_x(points))
        row = [sum_of_trapez]

        for n in range(1, k + 1):
            value = ((4 ** n) * row[n - 1] - A_k[k - 1][n - 1]) / ((4 ** n)- 1)
            row.append(value)

        A_k.append(row)

        if np.abs(A_k[k][k] - A_k[k - 1][k-1]) < stop:
            return A_k

    return A_k

def main():
    A = 17.0
    A_matrix = romberg_method(0,A)

    print(A_matrix[-1][-1])
    for i in range(len(A_matrix)):
        print(f"A_k,k={i}: {A_matrix[i][-1]:.10f}")

if __name__ == "__main__":
    main()
